{
  "name": "simulasi-tka-ujian",
  "productName": "Ujian TKA",
  "version": "1.0.0",
  "description": "Aplikasi ujian Simulasi TKA untuk komputer lab (Windows)",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "konfigurasi": "node scripts/siapkan-konfigurasi.mjs",
    "start": "npm run konfigurasi && electron .",
    "build:win": "npm run konfigurasi && electron-builder --win nsis --x64 --publish never",
    "build:linux": "npm run konfigurasi && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "build": {
    "appId": "id.sch.simulasitka.ujian",
    "productName": "Ujian TKA",
    "files": [
      "src/**",
      "konfigurasi.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "kamera-native/publish/kamera-native.exe",
          "to": "kamera-native/kamera-native.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ujian TKA",
      "artifactName": "Ujian-TKA-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Simulasi TKA <admin@simulasi-tka.invalid>",
      "synopsis": "Aplikasi ujian Simulasi TKA untuk komputer lab",
      "artifactName": "Ujian-TKA-${version}-${arch}.${ext}"
    },
    "publish": [],
    "deb": {
      "packageName": "ujian-tka"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "Simulasi TKA",
    "email": "admin@simulasi-tka.invalid"
  },
  "homepage": "https://github.com/mistersupri/simulasi-tka",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
