# Salin menjadi .env lalu sesuaikan.

# Pengembangan lokal (npm run dev): alamat PostgreSQL
DATABASE_URL="postgresql://postgres@localhost:5432/simulasi_tka"
PORT=3000
UPLOAD_DIR=./uploads

# Docker compose: kata sandi database (wajib)
DB_PASSWORD=ganti-dengan-kata-sandi-kuat

# Isi "true" bila aplikasi diakses lewat HTTPS (wajib untuk kamera di jaringan).
COOKIE_SECURE=false

# Kata sandi admin instansi (Suku Dinas) pertama untuk npm run db:seed (kosong = dibuat acak & ditampilkan)
ADMIN_PASSWORD=

# Opsional untuk db:seed: impor data dari file Excel versi Google Sheets
# SEED_EXCEL=../database/Database_Simulasi_TKA_SDN_Johar_Baru_01_Pagi.xlsx
# Sekolah untuk siswa dari SEED_EXCEL (dibuat bila belum ada)
# SEED_SEKOLAH=SDN Johar Baru 01 Pagi

# Lama sesi login (jam)
LAMA_SESI_JAM=8

# Aplikasi ujian Windows (folder desktop/): kunci bersama, minimal 16 karakter.
# Isi nilai yang sama ke TKA_KUNCI_APLIKASI saat membuat installer.
# Kosong = opsi "wajib lewat aplikasi" di jadwal ujian tidak bisa dipakai.
KUNCI_APLIKASI=
